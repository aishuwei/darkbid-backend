{
  "document_info": {
    "name": "暗标格式检查",
    "description": "自动生成的检查规则",
    "paper_size": "A4"
  },
  "page_check": {
    "enabled": true,
    "max_pages": 800
  },
  "margin_check": {
    "enabled": true,
    "top_cm": 2.54,
    "bottom_cm": 2.54,
    "left_cm": 3.17,
    "right_cm": 3.17
  },
  "font_check": {
    "enabled": true,
    "chinese_font": "宋体",
    "size_pt": 14,
    "color_hex": "000000",
    "allow_bold": false,
    "allow_italic": false,
    "allow_underline": false,
    "allow_color_change": false,
    "check_table_text": true
  },
  "paragraph_check": {
    "enabled": true,
    "alignment": "justify",
    "line_spacing_rule": "exact",
    "line_spacing_pt": 28,
    "first_line_indent_chars": 2,
    "space_before_pt": 0,
    "space_after_pt": 0,
    "allow_space_as_indent": false,
    "no_empty_paragraphs": true,
    "allow_left_indent": false,
    "allow_right_indent": false
  },
  "object_check": {
    "enabled": true,
    "table_alignment": "center",
    "table_text_alignment": "left",
    "table_indent_none": true,
    "table_spacing_none": true,
    "image_alignment": "center"
  },
  "structure_check": {
    "enabled": true,
    "allow_header": false,
    "allow_footer": false,
    "allow_page_number": false,
    "allow_toc": false,
    "allow_cover": false
  },
  "punctuation_check": {
    "enabled": true,
    "require_chinese": true
  }
}