{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "暗标排版规则配置 Schema（增强版）",
  "description": "包含页面、结构、边距、字体、段落、表格、标题、标点等全面检查配置。",
  "type": "object",
  "required": [
    "document_info",
    "page_check",
    "margin_check",
    "font_check",
    "paragraph_check",
    "structure_check",
    "table_check",
    "heading_check",
    "punctuation_check"
  ],
  "properties": {
    "document_info": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"], "description": "规则名称（如“××省××项目暗标规则”）" },
        "description": { "type": ["string", "null"], "description": "规则简短说明（项目来源、适用范围等）" },
        "generated_date": { "type": ["string", "null"], "description": "规则生成日期（YYYY-MM-DD）" }
      },
      "additionalProperties": false
    },
    "page_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "paper_size": { "type": ["string", "null"], "enum": ["A4", "A3", "B5", "LETTER"] },
        "max_pages": { "type": ["integer", "null"] },
        "no_blank_pages": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "margin_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "top_cm": { "type": ["number", "null"] },
        "bottom_cm": { "type": ["number", "null"] },
        "left_cm": { "type": ["number", "null"] },
        "right_cm": { "type": ["number", "null"] },
        "tolerance_cm": { "type": "number", "default": 0.1 }
      },
      "additionalProperties": false
    },
    "font_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "chinese_font": { "type": ["string", "null"] },
        "size_pt": { "type": ["number", "null"] },
        "color_hex": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{6}$", "default": "000000" },
        "allow_bold": { "type": "boolean", "default": false },
        "allow_italic": { "type": "boolean", "default": false },
        "allow_underline": { "type": "boolean", "default": false },
        "allow_color_change": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "paragraph_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "alignment": { "type": ["string", "null"], "enum": ["left", "center", "right", "justify"] },
        "line_spacing_rule": { "type": ["string", "null"], "enum": ["single", "one_half", "double", "exact", "multiple"] },
        "line_spacing_pt": { "type": ["number", "null"] },
        "line_spacing_tolerance_pt": { "type": "number", "default": 0.5 },
        "first_line_indent_chars": { "type": ["number", "null"] },
        "first_line_indent_tolerance_chars": { "type": "number", "default": 0.3 },
        "space_before_pt": { "type": ["number", "null"] },
        "space_after_pt": { "type": ["number", "null"] },
        "space_tolerance_pt": { "type": "number", "default": 0.5 },
        "allow_space_as_indent": { "type": "boolean", "default": true },
        "no_empty_paragraphs": { "type": "boolean", "default": false },
        "allow_left_indent": { "type": "boolean", "default": true },
        "allow_right_indent": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "structure_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "allow_toc": { "type": ["boolean", "null"], "default": null },
        "allow_header": { "type": ["boolean", "null"], "default": null },
        "allow_footer": { "type": ["boolean", "null"], "default": null },
        "allow_page_number": { "type": ["boolean", "null"], "default": null },
        "allow_cover": { "type": ["boolean", "null"], "default": null }
      },
      "additionalProperties": false
    },
    "table_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "table_alignment": { "type": ["string", "null"], "enum": ["left", "center", "right"] },
        "table_text_alignment": { "type": ["string", "null"], "enum": ["left", "center", "right", "justify"] },
        "table_indent_none": { "type": ["boolean", "null"] },
        "table_spacing_none": { "type": ["boolean", "null"] },
        "table_font_family": { "type": ["string", "null"], "default": "宋体" },
        "table_font_size_pt": { "type": ["number", "null"] },
        "table_font_color_hex": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{6}$", "default": "000000" },
        "table_allow_bold": { "type": ["boolean", "null"], "default": false },
        "table_allow_italic": { "type": ["boolean", "null"], "default": false },
        "table_allow_underline": { "type": ["boolean", "null"], "default": false },
        "table_allow_color_change": { "type": ["boolean", "null"], "default": false }
      },
      "additionalProperties": false
    },
    "heading_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "description": { "type": ["string", "null"] },
        "identification": {
          "type": "object",
          "properties": {
            "method": { "type": "string", "enum": ["regex", "style", "hybrid"], "default": "regex" },
            "patterns": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "style_mapping": {
              "type": "object",
              "additionalProperties": { "type": "integer" }
            }
          },
          "additionalProperties": false
        },
        "level_rules": {
          "type": "object",
          "properties": {
            "level_1": { "$ref": "#/definitions/level_rule" },
            "level_2": { "$ref": "#/definitions/level_rule" },
            "level_3": { "$ref": "#/definitions/level_rule" },
            "level_4": { "$ref": "#/definitions/level_rule" },
            "level_5": { "$ref": "#/definitions/level_rule" },
            "level_6": { "$ref": "#/definitions/level_rule" },
            "level_7": { "$ref": "#/definitions/level_rule" }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "properties": {
            "check_continuity": { "type": "boolean", "default": false },
            "check_hierarchy": { "type": "boolean", "default": false },
            "check_orphan_levels": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "punctuation_check": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] },
        "require_chinese": { "type": "boolean", "default": true },
        "no_space_between_chars": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "level_rule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "chinese_font": { "type": ["string", "null"], "default": "宋体" },
        "size_pt": { "type": ["number", "null"] },
        "color_hex": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{6}$", "default": "000000" },
        "allow_bold": { "type": "boolean", "default": false },
        "allow_italic": { "type": "boolean", "default": false },
        "allow_underline": { "type": "boolean", "default": false },
        "allow_color_change": { "type": "boolean", "default": false },
        "alignment": { "type": ["string", "null"], "enum": ["left", "center", "right", "justify"] },
        "number_format": {
          "type": "object",
          "properties": {
            "required_prefix": { "type": ["string", "null"] },
            "required_suffix": { "type": ["string", "null"] },
            "allowed_suffix": { "type": "array", "items": { "type": "string" } },
            "forbid_suffix": { "type": "array", "items": { "type": "string" } },
            "no_space_between_number_and_text": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}